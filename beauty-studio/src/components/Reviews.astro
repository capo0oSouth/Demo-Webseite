---
import Icon from './Icon.astro';
import { reviews } from '../data/content';
---

<div class="reviews" data-reviews>
  <div class="reviews__track" data-track tabindex="0" aria-label="Kundinnenstimmen" role="region">
    {reviews.map((r) => (
      <figure class="review">
        <div class="review__stars" role="img" aria-label="5 von 5 Sternen">
          {[1, 2, 3, 4, 5].map(() => (
            <Icon name="star" />
          ))}
        </div>
        <blockquote>
          <p>«{r.text}»</p>
        </blockquote>
        <figcaption>
          <strong>{r.name}</strong>
          <span>
            {r.place} · {r.service}
          </span>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="reviews__nav">
    <button type="button" class="reviews__btn" data-prev aria-label="Vorherige Bewertungen">
      <Icon name="arrowLeft" />
    </button>
    <button type="button" class="reviews__btn" data-next aria-label="Weitere Bewertungen">
      <Icon name="arrow" />
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const step = () => (track.querySelector<HTMLElement>('.review')?.offsetWidth ?? 300) + 20;
    root
      .querySelector('[data-prev]')
      ?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    root
      .querySelector('[data-next]')
      ?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>

<style>
  .reviews {
    display: grid;
    gap: 1.5rem;
  }

  .reviews__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(86%, 380px);
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 0.5rem 0.2rem 1.5rem;
    margin-inline: -0.2rem;
  }

  .reviews__track::-webkit-scrollbar {
    display: none;
  }

  .review {
    scroll-snap-align: start;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.8rem;
    border-radius: var(--radius-l);
    background: var(--white);
    box-shadow: var(--shadow-s);
  }

  .review__stars {
    display: flex;
    gap: 0.15rem;
    color: var(--gold-500);
  }

  .review__stars :global(svg) {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  blockquote {
    margin: 0;
    flex: 1;
    font-family: var(--font-display);
    font-size: 1.12rem;
    line-height: 1.55;
    font-weight: 350;
  }

  figcaption {
    display: grid;
    gap: 0.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }

  figcaption span {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .reviews__nav {
    display: flex;
    gap: 0.6rem;
    justify-content: flex-end;
  }

  .reviews__btn {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: transparent;
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .reviews__btn:hover {
    background: var(--plum-900);
    color: var(--porcelain);
  }

  .reviews__btn :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
</style>

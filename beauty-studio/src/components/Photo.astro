---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Illustration from './Illustration.astro';
import type { IllustrationName } from '../data/illustrations';
import Logo from './Logo.astro';

/**
 * Fotos liegen in src/assets/photos/<name>.jpg und werden automatisch als AVIF/WebP in
 * mehreren Grössen ausgeliefert. Fehlt ein Foto, erscheint eine gestaltete Illustration.
 */
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp,avif}',
  {
    eager: true,
  },
);

type Fallback =
  | 'nails'
  | 'nails-french'
  | 'nails-red'
  | 'nails-nude'
  | 'lashes'
  | 'lashes-classic'
  | 'lashes-lift'
  | 'brows'
  | 'brows-henna'
  | 'studio'
  | 'portrait';

interface Props {
  name: string;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fallback?: Fallback;
  position?: string;
  initial?: string;
}

const {
  name,
  alt,
  class: className,
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 1100px) 50vw, 100vw',
  loading = 'lazy',
  fallback = 'studio',
  position = 'center',
  initial,
} = Astro.props;

const match = Object.entries(photos).find(
  ([path]) =>
    path
      .split('/')
      .pop()!
      .replace(/\.[^.]+$/, '') === name,
);
const image = match?.[1].default;

const illustrationFor: Partial<Record<Fallback, IllustrationName>> = {
  nails: 'nails-rose-almond',
  'nails-french': 'nails-french-almond',
  'nails-red': 'nails-red-squoval',
  'nails-nude': 'nails-nude-accent',
  lashes: 'lashes-volume-cat',
  'lashes-classic': 'lashes-classic-natural',
  'lashes-lift': 'lashes-lift-tinted',
  brows: 'brows-lamination',
  'brows-henna': 'brows-henna',
};
---

{image ? (
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths
      .filter((w) => w <= image.width)
      .concat(widths.some((w) => w > image.width) ? [image.width] : [])}
    sizes={sizes}
    loading={loading}
    fetchpriority={loading === 'eager' ? 'high' : 'auto'}
    class:list={['photo', className]}
    pictureAttributes={{ class: 'photo-frame' }}
    style={`object-position: ${position}`}
  />
) : (
  <div
    class:list={['photo', 'photo--fallback', `photo--${fallback}`, className]}
    role="img"
    aria-label={alt}
  >
    {illustrationFor[fallback] && (
      <Illustration
        name={illustrationFor[fallback]!}
        alt=""
        fit={fallback.startsWith('nails') ? 'contain' : 'cover'}
        loading={loading}
      />
    )}
    {fallback === 'studio' && (
      <div class="studio-art" aria-hidden="true">
        <span class="studio-art__arch" />
        <span class="studio-art__arch studio-art__arch--2" />
        <Logo />
      </div>
    )}
    {fallback === 'portrait' && (
      <div class="portrait-art" aria-hidden="true">
        <span>{initial}</span>
      </div>
    )}
  </div>
)}

<style>
  /* Das <picture>-Element muss die Fläche ausfüllen, sonst behält das Bild seine eigene Höhe. */
  :global(.photo-frame) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo--fallback {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(70% 60% at 50% 35%, #fff 0%, rgba(255, 255, 255, 0) 70%),
      linear-gradient(160deg, var(--blush-100), var(--cream));
    display: grid;
    place-items: center;
  }

  .photo--fallback :global(.illustration) {
    position: absolute;
    inset: 0;
  }

  .studio-art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 50% at 50% 60%, rgba(255, 255, 255, 0.8), transparent 70%),
      linear-gradient(170deg, #f6e2dc, #efd9cf 60%, #e9cfc4);
  }

  .studio-art__arch {
    position: absolute;
    bottom: -10%;
    width: 46%;
    height: 78%;
    border-radius: 999px 999px 0 0;
    border: 1px solid rgba(191, 154, 92, 0.55);
  }

  .studio-art__arch--2 {
    width: 60%;
    height: 92%;
    border-color: rgba(191, 154, 92, 0.25);
  }

  .portrait-art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 50% at 50% 35%, rgba(255, 255, 255, 0.85), transparent 70%),
      linear-gradient(170deg, #f3dcd4, #e8c9bf);
  }

  .portrait-art span {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(3rem, 8vw, 6rem);
    color: var(--berry-700);
    opacity: 0.8;
  }
</style>

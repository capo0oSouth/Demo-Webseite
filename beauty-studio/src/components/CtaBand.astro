---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
  href?: string;
  label?: string;
}

const {
  title = 'Bereit für deine Auszeit?',
  text = 'Gestalte deinen Look online, sieh sofort den Preis und wähle deinen Wunschtermin – in wenigen Minuten.',
  href = '/buchen',
  label = 'Termin buchen',
} = Astro.props;
---

<section class="cta">
  <div class="container cta__inner reveal">
    <div class="cta__ornament" aria-hidden="true">
      <svg viewBox="-20 -20 40 40">
        <g fill="none" stroke="currentColor" stroke-width="0.6">
          <ellipse cx="0" cy="-7.2" rx="5.2" ry="9.6"></ellipse>
          <ellipse cx="0" cy="-7.2" rx="5.2" ry="9.6" transform="rotate(120)"></ellipse>
          <ellipse cx="0" cy="-7.2" rx="5.2" ry="9.6" transform="rotate(240)"></ellipse>
        </g>
      </svg>
    </div>
    <h2>{title}</h2>
    <p>{text}</p>
    <div class="cta__actions">
      <a href={href} class="btn btn--gold">
        <Icon name="calendar" />
        {label}
      </a>
      <a href="/kontakt" class="btn btn--ghost-light">
        Fragen? Kontakt
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
    background:
      radial-gradient(70% 90% at 50% 120%, rgba(148, 64, 90, 0.55), transparent 70%),
      var(--plum-900);
    color: var(--blush-100);
    overflow: hidden;
    text-align: center;
  }

  .cta__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.2rem;
  }

  .cta__ornament {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(560px, 110vw);
    translate: -50% -50%;
    color: var(--gold-400);
    opacity: 0.1;
    pointer-events: none;
  }

  .cta__ornament svg {
    width: 100%;
    animation: spin-slow 90s linear infinite;
  }

  @keyframes spin-slow {
    to {
      transform: rotate(360deg);
    }
  }

  h2 {
    position: relative;
    color: var(--porcelain);
    max-width: 16ch;
  }

  p {
    position: relative;
    max-width: 34rem;
    font-size: var(--step-1);
    font-weight: 350;
    color: rgba(251, 240, 236, 0.82);
  }

  .cta__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 0.6rem;
  }
</style>

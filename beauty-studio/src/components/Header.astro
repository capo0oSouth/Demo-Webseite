---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { navigation, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header" data-header>
  <div class="site-header__inner container">
    <a href="/" class="site-header__logo" aria-label={`${site.name} – zur Startseite`}>
      <Logo withClaim />
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation">
      <ul>
        {navigation.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="/buchen" class="btn btn--small site-header__cta" aria-label="Termin buchen">
        <Icon name="calendar" />
        <span>Termin buchen</span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="visually-hidden" data-menu-label>
          Menü öffnen
        </span>
        <span class="menu-toggle__bars" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <div class="mobile-menu__inner container">
      <nav aria-label="Mobile Navigation">
        <ul>
          {navigation.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
                <Icon name="arrow" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="mobile-menu__footer">
        <a href="/buchen" class="btn btn--accent">
          <Icon name="calendar" />
          Termin online buchen
        </a>
        <p>
          {site.address.street}, {`${site.address.zip} ${site.address.city}`}
          <br />
          <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
        </p>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (header && toggle && menu && label) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Menü schliessen' : 'Menü öffnen';
      header.classList.toggle('menu-open', open);
      document.documentElement.classList.toggle('scroll-lock', open);
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
        menu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
      } else {
        menu.classList.remove('is-open');
        window.setTimeout(() => {
          if (!menu.classList.contains('is-open')) menu.hidden = true;
        }, 400);
      }
    };

    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 1100px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    background: rgba(252, 248, 245, 0.82);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s,
      box-shadow 0.3s,
      background-color 0.3s;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 10px 30px -24px rgba(51, 24, 42, 0.35);
  }

  .site-header.menu-open {
    background: var(--porcelain);
  }

  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-header__logo {
    text-decoration: none;
    border-radius: 12px;
    flex: none;
  }

  .site-nav {
    display: none;
  }

  .site-nav ul {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    position: relative;
    padding-block: 0.5rem;
    font-size: 0.95rem;
    font-weight: 440;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--text-soft);
    transition: color 0.25s;
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 1px;
    background: var(--gold-500);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-out);
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--plum-900);
  }

  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: transparent;
  }

  .menu-toggle__bars {
    display: grid;
    gap: 6px;
    width: 18px;
  }

  .menu-toggle__bars span {
    display: block;
    height: 1.5px;
    background: var(--plum-900);
    border-radius: 2px;
    transition: transform 0.4s var(--ease-out);
  }

  .menu-open .menu-toggle__bars span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .menu-open .menu-toggle__bars span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--porcelain);
    overflow-y: auto;
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }

  .mobile-menu.is-open {
    opacity: 1;
  }

  .mobile-menu__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.5rem 2.5rem;
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu li {
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i) * 45ms + 80ms);
  }

  .mobile-menu.is-open li {
    opacity: 1;
    transform: none;
  }

  .mobile-menu li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.05rem 0.2rem;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 7vw, 2.3rem);
    font-weight: 340;
    text-decoration: none;
  }

  .mobile-menu li a[aria-current='page'] {
    color: var(--berry-700);
    font-style: italic;
  }

  .mobile-menu li a :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
    color: var(--gold-500);
  }

  .mobile-menu__footer {
    display: grid;
    gap: 1.2rem;
    color: var(--text-soft);
  }

  .mobile-menu__footer .btn {
    width: 100%;
  }

  @media (max-width: 520px) {
    .site-header__cta {
      padding-inline: 0.85rem;
    }

    .site-header__cta span {
      display: none;
    }

    .site-header__cta {
      width: 2.9rem;
      height: 2.9rem;
      min-height: 0;
      padding: 0;
      border-radius: 50%;
    }
  }

  @media (max-width: 380px) {
    .site-header :global(.logo__claim) {
      display: none;
    }
  }

  @media (min-width: 1100px) {
    .site-nav {
      display: block;
    }

    .menu-toggle,
    .mobile-menu {
      display: none;
    }
  }
</style>

---
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
  size?: number | string;
  strokeWidth?: number;
}

const { name, class: className, size, strokeWidth = 1.5 } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>

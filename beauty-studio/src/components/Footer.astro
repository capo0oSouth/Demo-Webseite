---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__logo" aria-label={`${site.name} – zur Startseite`}>
        <Logo variant="light" withClaim />
      </a>
      <p>{site.tagline}</p>
      <a href="/buchen" class="btn btn--gold btn--small">
        Termin buchen
        <Icon name="arrow" class="arrow" />
      </a>
    </div>

    <nav class="site-footer__col" aria-label="Behandlungen">
      <h2>Behandlungen</h2>
      <ul>
        <li>
          <a href="/nails">Nails</a>
        </li>
        <li>
          <a href="/lashes">Lashes</a>
        </li>
        <li>
          <a href="/brows">Brows</a>
        </li>
        <li>
          <a href="/preise">Preisliste</a>
        </li>
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Studio">
      <h2>Studio</h2>
      <ul>
        <li>
          <a href="/studio">Studio & Team</a>
        </li>
        <li>
          <a href="/kontakt">Kontakt & Anfahrt</a>
        </li>
        <li>
          <a href="/kontakt#gutscheine">Gutscheine</a>
        </li>
        <li>
          <a href="/buchen">Online buchen</a>
        </li>
      </ul>
    </nav>

    <div class="site-footer__col">
      <h2>Öffnungszeiten</h2>
      <dl class="hours">
        <div>
          <dt>Di – Fr</dt>
          <dd>09:00 – 19:00</dd>
        </div>
        <div>
          <dt>Donnerstag</dt>
          <dd>bis 20:00</dd>
        </div>
        <div>
          <dt>Samstag</dt>
          <dd>09:00 – 16:00</dd>
        </div>
        <div>
          <dt>So & Mo</dt>
          <dd>geschlossen</dd>
        </div>
      </dl>
    </div>

    <address class="site-footer__col">
      <h2>Kontakt</h2>
      <ul>
        <li>
          <Icon name="pin" />
          <span>
            {site.address.street}
            <br />
            {site.address.zip} {site.address.city}
          </span>
        </li>
        <li>
          <Icon name="phone" />
          <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
        </li>
        <li>
          <Icon name="mail" />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <Icon name="instagram" />
          <span>{site.instagram}</span>
        </li>
      </ul>
    </address>
  </div>

  <div class="container site-footer__bottom">
    <p>
      © {year} {site.name} · {site.address.city}
    </p>
    <ul>
      <li>
        <a href="/impressum">Impressum</a>
      </li>
      <li>
        <a href="/datenschutz">Datenschutz</a>
      </li>
      <li>
        <a href="/agb">AGB & Stornierung</a>
      </li>
    </ul>
  </div>
  <p class="site-footer__demo container">
    <Icon name="info" />
    Demo-Website: {site.name} ist ein fiktives Studio. Namen, Adresse, Kontaktdaten und Bewertungen
    sind frei erfunden. Buchungen und Formulare übertragen keine Daten.
  </p>
</footer>

<style>
  .site-footer {
    position: relative;
    background:
      radial-gradient(80% 60% at 90% 0%, rgba(148, 64, 90, 0.35), transparent 70%), var(--plum-900);
    color: rgba(251, 240, 236, 0.78);
    padding-top: clamp(3.5rem, 3rem + 3vw, 6rem);
    font-size: 0.95rem;
  }

  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-400), transparent);
    opacity: 0.6;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  .site-footer a:hover {
    color: var(--gold-300);
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .site-footer__brand {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    max-width: 22rem;
  }

  .site-footer__brand p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--blush-100);
  }

  .site-footer__brand .btn,
  .site-footer__brand .btn:hover {
    color: var(--plum-900);
  }

  .site-footer h2 {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 520;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-300);
    margin-bottom: 1rem;
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  address.site-footer__col {
    font-style: normal;
    grid-column: 1 / -1;
  }

  address li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
  }

  address li :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.25rem;
    flex: none;
    color: var(--gold-400);
  }

  .hours {
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }

  .hours div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .hours dt {
    color: var(--blush-100);
  }

  .hours dd {
    margin: 0;
    white-space: nowrap;
  }

  .site-footer__bottom {
    margin-top: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    padding-block: 1.5rem;
    border-top: 1px solid rgba(251, 240, 236, 0.14);
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2rem;
    justify-content: space-between;
    font-size: 0.85rem;
  }

  .site-footer__bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__demo {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    padding-bottom: 2rem;
    font-size: 0.78rem;
    color: rgba(251, 240, 236, 0.62);
  }

  .site-footer__demo :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
    margin-top: 0.15rem;
  }

  @media (min-width: 760px) {
    .site-footer__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    address.site-footer__col {
      grid-column: auto;
    }
  }

  @media (min-width: 1100px) {
    .site-footer__grid {
      grid-template-columns: 1.5fr repeat(4, minmax(0, 1fr));
    }

    .site-footer__brand {
      grid-column: auto;
    }
  }
</style>

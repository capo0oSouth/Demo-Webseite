---
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
  withClaim?: boolean;
}

const { variant = 'dark', class: className, withClaim = false } = Astro.props;
const gid = `logo-gold-${variant}`;
---

<span class:list={['logo', `logo--${variant}`, className]}>
  <svg class="logo__mark" viewBox="-20 -20 40 40" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#EBD6A8"></stop>
        <stop offset="0.45" stop-color="#BF9A5C"></stop>
        <stop offset="0.7" stop-color="#E4C995"></stop>
        <stop offset="1" stop-color="#A9844A"></stop>
      </linearGradient>
    </defs>
    <g fill="none" stroke={`url(#${gid})`} stroke-width="1.35">
      <ellipse cx="0" cy="-7.2" rx="5.2" ry="9.6"></ellipse>
      <ellipse cx="0" cy="-7.2" rx="5.2" ry="9.6" transform="rotate(120)"></ellipse>
      <ellipse cx="0" cy="-7.2" rx="5.2" ry="9.6" transform="rotate(240)"></ellipse>
      <circle cx="0" cy="0" r="18.4" stroke-width="0.9" opacity="0.7"></circle>
    </g>
    <circle cx="0" cy="0" r="1.6" fill={`url(#${gid})`}></circle>
  </svg>
  <span class="logo__text">
    <span class="logo__name">
      Maison <em>Trois</em>
    </span>
    {withClaim && <span class="logo__claim">Nails · Lashes · Brows</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--plum-900);
    line-height: 1;
  }

  .logo--light {
    color: var(--porcelain);
  }

  .logo__mark {
    width: 2.35rem;
    height: 2.35rem;
    flex: none;
    transition: transform 1.2s var(--ease-out);
  }

  .logo:hover .logo__mark {
    transform: rotate(120deg);
  }

  .logo__text {
    display: grid;
    gap: 0.3rem;
  }

  .logo__name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 380;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .logo__name em {
    font-weight: 320;
  }

  .logo__claim {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    opacity: 0.75;
  }
</style>

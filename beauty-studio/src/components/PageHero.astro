---
import Icon from './Icon.astro';
import Photo from './Photo.astro';

interface Props {
  eyebrow: string;
  lead: string;
  photo?: string;
  photoAlt?: string;
  fallback?: 'nails' | 'nails-french' | 'lashes' | 'lashes-classic' | 'brows' | 'studio';
  facts?: { value: string; label: string }[];
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
}

const {
  eyebrow,
  lead,
  photo,
  photoAlt = '',
  fallback = 'studio',
  facts = [],
  primary,
  secondary,
} = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--text': !photo }]}>
  <div class="container page-hero__grid">
    <div class="page-hero__copy">
      <nav class="crumbs reveal" aria-label="Brotkrumen">
        <a href="/">Start</a>
        <Icon name="chevronRight" />
        <span aria-current="page">{eyebrow}</span>
      </nav>
      <h1 class="reveal" style="--delay: 80">
        <slot />
      </h1>
      <p class="lead reveal" style="--delay: 160">
        {lead}
      </p>
      {(primary || secondary) && (
        <div class="page-hero__actions reveal" style="--delay: 240">
          {primary && (
            <a href={primary.href} class="btn btn--accent">
              <Icon name="calendar" />
              {primary.label}
            </a>
          )}
          {secondary && (
            <a href={secondary.href} class="btn btn--outline">
              {secondary.label}
            </a>
          )}
        </div>
      )}
      {facts.length > 0 && (
        <ul class="page-hero__facts reveal" style="--delay: 320">
          {facts.map((f) => (
            <li>
              <strong>{f.value}</strong>
              <span>{f.label}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
    {photo && (
      <div class="page-hero__media reveal-mask">
        <Photo
          name={photo}
          alt={photoAlt}
          fallback={fallback}
          loading="eager"
          sizes="(min-width: 960px) 45vw, 100vw"
        />
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(2rem, 1.5rem + 2.5vw, 4rem) clamp(3rem, 2.5rem + 3vw, 5.5rem);
    background:
      radial-gradient(55% 60% at 90% 10%, rgba(239, 207, 198, 0.65), transparent 70%),
      var(--porcelain);
    overflow: hidden;
  }

  .page-hero__grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 3vw, 4rem);
    align-items: center;
  }

  @media (min-width: 960px) {
    .page-hero:not(.page-hero--text) .page-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }

  .page-hero__copy {
    display: grid;
    gap: 1.3rem;
    justify-items: start;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-600);
  }

  .crumbs a {
    text-decoration: none;
    color: var(--text-muted);
  }

  .crumbs a:hover {
    color: var(--plum-900);
  }

  .crumbs :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--text-muted);
  }

  h1 {
    font-size: var(--step-5);
    max-width: 14ch;
  }

  .lead {
    max-width: 36rem;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .page-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.2rem;
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 1.3rem 0 0;
    border-top: 1px solid var(--line);
  }

  .page-hero__facts li {
    display: grid;
  }

  .page-hero__facts strong {
    font-family: var(--font-display);
    font-weight: 380;
    font-size: 1.6rem;
    line-height: 1.15;
  }

  .page-hero__facts span {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .page-hero__media {
    aspect-ratio: 4 / 4.4;
    max-width: 540px;
    width: 100%;
    justify-self: center;
    border-radius: var(--arch);
    overflow: hidden;
    box-shadow: var(--shadow-l);
  }

  .page-hero__media.reveal-mask {
    clip-path: inset(100% 0 0 0 round 999px 999px 32px 32px);
  }

  .page-hero__media.reveal-mask.is-visible {
    clip-path: inset(0 0 0 0 round 999px 999px 32px 32px);
  }
</style>
